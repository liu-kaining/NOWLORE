# Runtime
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
ADMIN_TOKEN=local-admin-change-me
CRON_TOKEN=local-cron-change-me

# Storage: memory | json | firestore
STORE_DRIVER=json
JSON_STORE_PATH=./data/nowlore.json
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)

# AI: mock | openai-responses | openai-chat | anthropic
AI_PROTOCOL=mock
AI_BASE_URL=
AI_MODEL=mock-v1
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=3000
AI_TEMPERATURE=0.2

# Sources
RSS_FEEDS=
POLYMARKET_ENABLED=true
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
HACKERNEWS_ENABLED=true
HUGGINGFACE_ENABLED=true
SOURCE_TIMEOUT_MS=10000
SOURCE_MAX_ITEMS=30

# Assets: local | r2
ASSET_DRIVER=local
ASSET_LOCAL_PATH=./data/assets
ASSET_PUBLIC_BASE_URL=http://localhost:8080/assets
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Chain: dry-run | pump
CHAIN_MODE=dry-run
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_ENABLED=false
SOLANA_COMMITMENT=confirmed
SOLANA_SIMULATION_TTL_SECONDS=600

# Signer: disabled | local | gcp-kms
SIGNER_MODE=disabled
SOLANA_PRIVATE_KEY=
GCP_KMS_KEY_NAME=
GCP_KMS_PUBLIC_KEY=
